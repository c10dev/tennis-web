{
  "name": "tennis-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "game",
    "renderer",
    "ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --project engine --project game --project renderer",
    "test:engine": "vitest run --project engine",
    "test:renderer": "vitest run --project renderer",
    "test:stats": "vitest run --project stats",
    "coverage": "vitest run --project engine --coverage",
    "sim": "tsx engine/cli/sim.ts",
    "typecheck": "tsc -p engine/tsconfig.json --noEmit && tsc -p game/tsconfig.json --noEmit && tsc -p renderer/tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:game": "vitest run --project game",
    "test:season": "vitest run --project season",
    "season": "tsx game/cli/season.ts",
    "quick": "tsx game/cli/quick.ts",
    "test:quick": "vitest run --project quick"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
